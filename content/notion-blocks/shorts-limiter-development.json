            "content": "{\n  \"manifest_version\": 3,\n  \"name\": \"Shorts Limiter\",\n  \"version\": \"0.6.0\",\n  \"description\": \"Limits YouTube Shorts and Instagram Reels usage.\",\n\n  \"permissions\": [\n    \"storage\"\n  ],\n\n  \"action\": {\n    \"default_title\": \"Shorts Limiter\",\n    \"default_popup\": \"popup.html\"\n  },\n\n  \"background\": {\n    \"service_worker\": \"background.js\"\n  },\n\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://www.youtube.com/*\"\n      ],\n      \"js\": [\n        \"content.js\"\n      ],\n      \"css\": [\n        \"blocker.css\"\n      ]\n    }\n  ]\n}",
            "link": null
          },
          "annotations": {
