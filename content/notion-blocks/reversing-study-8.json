            "content": "import hashlib\n\nn = 16045690984833335023\niter = 312647161260980926\nmask = 2**64\nprint(mask)\n\ndef sub_1259_iter(n, iter, mask):\n    n = pow(n , pow(3, iter, mask) , mask)\n    return n\n\ndef sub_11A9(a1):\n    s = \"0123456789abcdef\"\n    v4 = []\n    for i in range(32):\n        # print(a1[i])\n        v4.append(s[int(a1[i]) >> 4])\n        v4.append(s[int(a1[i]) & 15])\n    print(len(v4))\n    return v4\n\n\nn = sub_1259_iter(n, iter, mask)\nn = n.to_bytes(8,\"little\")\nprint(n)\nsha256 = hashlib.sha256(n).digest() # 해시 암호화 기법, digest를 통해 16진수 바이트로 변환\nprint((sha256).hex())\nv3 = sub_11A9((sha256))\nprint(v3)\nprint(\"DH{\", end=\"\")\nfor x in v3:\n    print(x, end = \"\")\nprint(\"}\")",
