            "content": "byte_4040 = [0 for x in range(72)]\n\nwith open(\"baseball/text_in.txt\",\"rb\") as t_in, open(\"baseball/text_out.txt\",\"rb\") as t_out:\n    t_in = t_in.read()\n    t_out = t_out.read()\n    t_out_l = list(t_out)\n    inputsize = len(t_in)\n    size = (4*inputsize / 3+4) / 72 + 4*inputsize / 3+4+1\n\n    ### table\n    i, j = 0, 0\n    while(inputsize - i > 2):\n        byte_4040[t_in[i+0] >> 2] = t_out[j+0]\n        byte_4040[t_in[i+1] >> 4 | (16 * t_in[i+0]) & 48] = t_out[j+1]\n        byte_4040[t_in[i+2] >> 6 | (4 * t_in[i+1]) & 60] = t_out[j+2]\n        byte_4040[t_in[i+2] & 63] = t_out[j+3]\n        # t_out_l[j+0], t_out_l[j+1], t_out_l[j+2], t_out_l[j+3] = 0,0,0,0\n        i+=3\n        j+=4\n    if (inputsize - i != 0):\n        byte_4040[t_in[i] >> 2] = t_out[j]\n        if (inputsize - i == 1):\n            byte_4040[(16 * t_in[i]) & 48] = t_out[j+1]\n            # 마지막을 61 -> =\n            # t_out_l[j], t_out_l[j+1] = 0, 0\n        else:\n            byte_4040[(t_in[i+1] >> 4) | (16 * t_in[i]) & 48] = t_out[j+1]\n            byte_4040[(4 * t_in[i+1]) & 60] = t_out[j+2]\n            # 마지막을 61 -> =\n            # t_out_l[j], t_out_l[j+1], t_out_l[j+2] = 0, 0 ,0\n            \n    print(byte_4040)\n    # print(t_out_l)\n\n### flag\ni = 0\nflag = []\nwith open(\"baseball/flag_out.txt\",\"rb\") as out:\n    out = out.read()\n    \n    while(len(out) - i > 4):\n        flag.append( (byte_4040.index(out[i+0]) << 2) & 252 | (byte_4040.index(out[i+1]) >> 4) & 3 )\n        flag.append( (byte_4040.index(out[i+1]) << 4) & 240 | (byte_4040.index(out[i+2]) >> 2) & 15 )\n        flag.append( (byte_4040.index(out[i+2]) << 6) & 192 | (byte_4040.index(out[i+3]) >> 0) & 63 )\n        i += 4\n    \n    if ((len(out) - i) == 4):\n        flag.append( (byte_4040.index(out[i+0]) << 2) & 252 | (byte_4040.index(out[i+1]) >> 4) & 3 )\n        flag.append( (byte_4040.index(out[i+1]) << 4) & 240 | (byte_4040.index(out[i+2]) >> 2) & 15 )\n        \n    elif ((len(out) - i) == 3):\n        flag.append( (byte_4040.index(out[i+0]) << 2) & 252 | (byte_4040.index(out[i+1]) >> 4) & 3 )        \nprint(flag)\n\nprint(\"DH{\", end=\"\")\nfor x in flag:\n    print(chr(x),end=\"\")\nprint(\"}\")",
