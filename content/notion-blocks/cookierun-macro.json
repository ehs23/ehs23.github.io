    "type": "paragraph",
    "paragraph": {
      "rich_text": [
        {
          "type": "text",
          "text": {
            "content": "블루스택에서 사용했으며 쿠키런은 계정 2개까지 동시에 플레이 할 수 있음을 이용해 멀티창으로 2개를 한꺼번에 돌렸다. 블루스택에는 고급 디버깅 브리징 기능을 지원을 하기 때문에 코드가 각 블루스택에서 따로 돌아가서 ",
            "link": null
          },
          "annotations": {
            "bold": false,
            "italic": false,
            "strikethrough": false,
            "underline": false,
            "code": false,
            "color": "default"
          },
          "plain_text": "블루스택에서 사용했으며 쿠키런은 계정 2개까지 동시에 플레이 할 수 있음을 이용해 멀티창으로 2개를 한꺼번에 돌렸다. 블루스택에는 고급 디버깅 브리징 기능을 지원을 하기 때문에 코드가 각 블루스택에서 따로 돌아가서 ",
          "href": null
